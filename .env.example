# ==============================================================================
# Review Intelligence Prototype - Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (macOS / Linux)
#
# DO NOT COMMIT your real .env file or real API keys to git.

# ------------------------------------------------------------------------------
# 1. LLM Provider Selection
# ------------------------------------------------------------------------------
# Options: "none" | "ollama" | "api" (default: "none")
#
# - "none": Zero external calls. Uses deterministic templates and pandas calculations.
#           Works 100% out-of-the-box with zero accounts or setup.
# - "ollama": Local, offline inference via Ollama (no external internet calls).
# - "api": OpenAI-compatible cloud provider (Groq, OpenAI, Anthropic-proxy, Azure).
LLM_PROVIDER=none

# ------------------------------------------------------------------------------
# 2. Base URL & Model Name
# ------------------------------------------------------------------------------
# For Ollama (default: http://localhost:11434, model: llama3.2:3b):
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2:3b

# For Cloud API (e.g., Groq - ultra-fast inference):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# For OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. API Key (Only required when LLM_PROVIDER=api; leave empty otherwise)
# ------------------------------------------------------------------------------
# SECURITY NOTICE: Read strictly on the server. Never exposed to browser or client.
LLM_API_KEY=

# ------------------------------------------------------------------------------
# 4. Operational Limits & Rate Controls
# ------------------------------------------------------------------------------
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=600
LLM_DAILY_CALL_CAP=200

# ------------------------------------------------------------------------------
# 5. Asset Downloader (Optional)
# ------------------------------------------------------------------------------
# Token for downloading full weights from private Hugging Face repositories:
# HF_TOKEN=
# HF_REPO_ID=Ishaan/review-intelligence-assets
